{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HotStory",
  "version": "0.1.0",
  "identifier": "com.hotstory.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HotStory",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "resources": {
      "../runtime/": "runtime/"
    },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/128x128.png"]
  }
}
