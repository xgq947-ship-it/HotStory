LOG_LEVEL=INFO
# 打开后每个 HTTP 请求都会写一行日志；本地排查时再开
ACCESS_LOG=false

DATABASE_URL=sqlite:///./data/hotstory.db
SQLITE_BUSY_TIMEOUT_MS=30000
RESEARCH_ENGINE=native

# deepseek（推荐）、codex_cli、openai、anthropic、openai_compatible、mock
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# duckduckgo 无需 Key；也支持 tavily、brave、serper
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

CRAWLER_PROVIDER=auto
HOTSPOT_PROVIDER=auto
DAILYHOT_API_BASE_URL=https://api-hot.imsyy.top
TRENDRADAR_API_BASE_URL=

MAX_SEARCH_RESULTS=60
SEARCH_RESULTS_PER_QUERY=8
MIN_VALID_SOURCES=10
MIN_VERIFIED_FACTS=12
MIN_PERSONAL_CASES=2
MIN_KEY_DATA=2
ENABLE_PLAYWRIGHT_FALLBACK=true
REQUEST_TIMEOUT_SECONDS=25
MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=240
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=65536
LLM_CONCURRENCY=3
# 本地单用户：同时只跑一条管道，两条会让所有开销翻倍
MAX_CONCURRENT_PIPELINES=1
# 每题保留的 llm_raw 原始响应文件数；0 表示不清理
LLM_RAW_RETENTION=200
# 每次搜索之间的随机停顿，缓解 DuckDuckGo 限流
SEARCH_QUERY_PAUSE_SECONDS=0.6
# 搜索成功率低于该比例时直接在 search 步报错，而不是拖到 fetch 步
SEARCH_MIN_SUCCESS_RATIO=0.2
# 全局使用 DeepSeek V4 Flash MAX：所有研究、写稿与影视步骤均启用
DEEPSEEK_THINKING_ENABLED=true
DEEPSEEK_REASONING_EFFORT=max
PRODUCTION_DEEPSEEK_REASONING_EFFORT=max
PRODUCTION_LLM_TIMEOUT_SECONDS=240
PRODUCTION_LLM_MAX_OUTPUT_TOKENS=65536

# Codex CLI 备用 Provider
CODEX_CLI_PATH=codex
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=480
